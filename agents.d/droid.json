{
  "id": "droid",
  "displayName": "Factory Droid",
  "deployMode": "hook",
  "detection": {
    "paths": ["~/.factory"],
    "commands": ["droid"]
  },
  "hook": {
    "settingsPath": "~/.factory/settings.json",
    "events": [
      "SessionStart",
      "UserPromptSubmit",
      "PreToolUse",
      "PostToolUse",
      "Stop",
      "SubagentStop",
      "SessionEnd"
    ],
    "hookCommand": "$PILOT_DATA/hooks/droid-loongsuite-pilot-hook.sh",
    "format": "nested",
    "eventSubcommand": "kebab-case",
    "eventMatchers": {
      "PreToolUse": ".*",
      "PostToolUse": ".*"
    }
  },
  "input": {
    "type": "droid-transcript",
    "eventDir": "$PILOT_DATA/state/droid/hook-events"
  }
}
